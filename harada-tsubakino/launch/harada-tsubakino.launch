<launch>
  <arg name="group" default="$(optenv HOSTNAME rover)" />
  <arg name="instrumented_drive" default="true" />
  <arg name="i2c_persistent" default="true" />
  <arg name="trace_enabled" default="true" />
  <!-- Empty mode preserves the legacy trace_enabled true/false mapping. -->
  <arg name="trace_mode" default="" />
  <arg name="trace_summary_interval" default="5.0" />
  <arg name="trace_queue_capacity" default="2048" />
  <arg name="trace_publish_hz" default="20" />
  <param name="rosconsole_config_file" value="$(find harada-tsubakino)/config/rosconsole.conf" if="$(optenv USE_ROSLOG_CONFIG false)" />

  <group ns="$(arg group)">
    <node pkg="lightrover_ros" type="i2c_controller.py" name="rover_i2c_controller" />
    <node pkg="lightrover_ros" type="odometry.py" name="rover_odometry" unless="$(arg instrumented_drive)">
      <!-- Publish wheel odometry under the same source-based hierarchy as OTOS. -->
      <remap from="odom" to="odometry/wheel" />
      <!-- The upstream node uses unprefixed TF frame IDs. Keep that TF out of
           the shared /tf topic. The onboard OTOS publishes a separate,
           explicitly named sensor transform below. -->
      <remap from="/tf" to="/$(arg group)/wheel_tf_internal" />
    </node>
    <node pkg="lightrover_ros" type="pos_controller.py" name="rover_pos" unless="$(arg instrumented_drive)">
      <!-- Keep velocity feedback connected to the renamed wheel topic. -->
      <remap from="odom" to="odometry/wheel" />
    </node>
    <node pkg="harada-tsubakino" type="tracedOdometry.py" name="rover_odometry" if="$(arg instrumented_drive)">
      <param name="i2c_persistent" type="bool" value="$(arg i2c_persistent)" />
      <remap from="odom" to="odometry/wheel" />
      <remap from="/tf" to="/$(arg group)/wheel_tf_internal" />
      <param name="trace_enabled" type="bool" value="$(arg trace_enabled)" />
      <param name="trace_mode" type="str" value="$(arg trace_mode)" />
      <param name="trace_summary_interval" value="$(arg trace_summary_interval)" />
      <param name="trace_queue_capacity" value="$(arg trace_queue_capacity)" />
      <param name="trace_publish_hz" value="$(arg trace_publish_hz)" />
    </node>
    <node pkg="harada-tsubakino" type="tracedPosController.py" name="rover_pos" if="$(arg instrumented_drive)">
      <param name="i2c_persistent" type="bool" value="$(arg i2c_persistent)" />
      <remap from="odom" to="odometry/wheel" />
      <param name="trace_enabled" type="bool" value="$(arg trace_enabled)" />
      <param name="trace_mode" type="str" value="$(arg trace_mode)" />
      <param name="trace_summary_interval" value="$(arg trace_summary_interval)" />
      <param name="trace_queue_capacity" value="$(arg trace_queue_capacity)" />
      <param name="trace_publish_hz" value="$(arg trace_publish_hz)" />
    </node>
    <node pkg="harada-tsubakino" type="serialSensorBridge.py" name="serial_sensor_bridge" output="screen">
      <env name="PYTHONUNBUFFERED" value="1" />
      <param name="port" value="/dev/ttyACM0" />
      <param name="baud" value="115200" />
      <param name="otos_odom_frame" value="$(arg group)/otos_odom" />
      <param name="otos_base_link_frame" value="$(arg group)/otos_base_link" />
      <param name="imu_frame" value="$(arg group)/hmc6343_link" />
    </node>
  </group>

</launch>
